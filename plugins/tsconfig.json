{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "baseUrl": ".",
    "paths": {
      "@manifold/plugin": ["../../manifold/packages/plugin/src/index.ts"],
      "@manifold/plugin/hooks": ["../../manifold/packages/plugin/src/hooks.ts"],
      "@manifold/plugin-kit/server": ["../../manifold/packages/plugin-kit/src/server.ts"],
      "@manifold/protocol": ["../../manifold/packages/protocol/src/index.ts"],
      "@manifold/ui": ["../../manifold/packages/ui/src/index.ts"],
      "@manifold/sdk": ["../../manifold/packages/sdk/src/index.ts"],
      "@manifold/scene": ["../../manifold/packages/scene/src/index.ts"],
      "react": ["../../manifold/node_modules/react", "./node_modules/@types/react"],
      "react/*": ["../../manifold/node_modules/react/*", "./node_modules/@types/react/*"],
      "react-dom": ["../../manifold/node_modules/react-dom", "./node_modules/@types/react-dom"],
      "react-dom/*": ["../../manifold/node_modules/react-dom/*", "./node_modules/@types/react-dom/*"]
    }
  },
  "include": [
    "atyrode.code/**/*",
    "test/**/*",
    "../../manifold/packages/plugin/src/css-modules.d.ts"
  ]
}
